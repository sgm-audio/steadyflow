{
  "name": "steadyflow",
  "version": "0.1.1",
  "private": true,
  "description": "SteadyFlow — private pilot, auditable Shopify revenue-audit platform.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/stop.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contract": "turbo run contract",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,sql}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:lint": "supabase db lint",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "functions:serve": "supabase functions serve",
    "functions:deploy": "supabase functions deploy",
    "prepare": "husky || true",
    "scaffold": "pnpm --filter @steadyflow/devkit scaffold",
    "scaffold:shopify-theme": "pnpm --filter @steadyflow/devkit scaffold shopify-theme",
    "scaffold:shopify-app": "pnpm --filter @steadyflow/devkit scaffold shopify-app",
    "scaffold:wp-plugin": "pnpm --filter @steadyflow/devkit scaffold wordpress-plugin",
    "scaffold:wp-theme": "pnpm --filter @steadyflow/devkit scaffold wordpress-theme"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "eslint": "^9.10.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.7",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "turbo": "^2.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
