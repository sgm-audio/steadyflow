      "severity": "blocker",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/launch/app-requirements-checklist",
      "officialSourceTitle": "App Requirements Checklist",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#name-description",
      "notes": "Required for App Store listing",
      "evidenceExpectations": ["Non-empty name", "Non-empty description"]
    },
    {
      "id": "dev-urls",
      "title": "Hardcoded Development URLs",
      "description": "App must not contain hardcoded development URLs",
      "category": "security",
      "severity": "blocker",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/launch/app-requirements-checklist",
      "officialSourceTitle": "App Requirements Checklist",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#dev-urls",
      "notes": "No localhost, ngrok, or tunnel URLs in production code",
