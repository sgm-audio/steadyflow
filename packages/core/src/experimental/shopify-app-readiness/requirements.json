{
  "version": "1.0.0",
  "schemaVersion": "1.0",
  "requirements": [
    {
      "id": "config-parsing",
      "title": "Configuration Parsing",
      "description": "App configuration must be valid JSON and contain required fields",
      "category": "other",
      "severity": "blocker",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/build/shopify-app-configuration",
      "officialSourceTitle": "Shopify App Configuration",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#config-parsing",
      "notes": "App must be parseable and have valid structure",
      "evidenceExpectations": ["Valid JSON", "Required fields present"]
    },
    {
      "id": "api-scopes",
      "title": "API Scopes",
      "description": "App must request only necessary API scopes",
      "category": "api",
      "severity": "warning",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/getting-started/scopes",
      "officialSourceTitle": "Shopify API Scopes",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#api-scopes",
      "notes": "Only request scopes that are necessary for your app's functionality",
      "evidenceExpectations": ["Scopes declared in shopify.app.toml", "Requested scopes match actual API usage"]
    },
    {
      "id": "deprecated-api",
      "title": "Deprecated API Detection",
      "description": "App must not use deprecated REST/GraphQL APIs",
      "category": "api",
      "severity": "blocker",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/api/usage/versioning",
      "officialSourceTitle": "API Versioning",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#deprecated-api",
      "notes": "Apps using deprecated APIs will fail review",
      "evidenceExpectations": ["No deprecated API calls in code", "Uses supported API versions"]
    },
    {
      "id": "oauth-installation",
      "title": "OAuth Installation",
      "description": "App must use Shopify OAuth for authentication and authorization",
      "category": "authentication",
      "severity": "blocker",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/getting-started/authentication",
      "officialSourceTitle": "Shopify App Authentication",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#authentication",
      "notes": "OAuth is required for all public apps",
      "evidenceExpectations": ["OAuth redirect URI matches registered URI", "Authorization code is properly handled", "Access token is securely stored"]
    },
    {
      "id": "embedded-app",
      "title": "Embedded App",
      "description": "Embedded apps must use App Bridge",
      "category": "functionality",
      "severity": "warning",
      "validationMode": "manual",
      "applicability": ["embedded_public_app"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/tools/app-bridge",
      "officialSourceTitle": "App Bridge",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#embedded-app",
      "notes": "Verify App Bridge usage manually",
      "evidenceExpectations": ["App Bridge loaded in embedded context", "Navigation works correctly"]
    },
    {
      "id": "theme-extension",
      "title": "Theme App Extension",
      "description": "App must use theme app extensions for theme modifications",
      "category": "theme",
      "severity": "warning",
      "validationMode": "manual",
      "applicability": ["theme"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/launch/theme-app-extensions",
      "officialSourceTitle": "Theme App Extensions",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#theme",
      "notes": "Use official theme app extension mechanisms",
      "evidenceExpectations": ["Uses official theme app extension API", "Follows Shopify's extension manifest format"]
    },
    {
      "id": "direct-mutations",
      "title": "Direct Mutation Flags",
      "description": "App must not perform direct database mutations bypassing Shopify APIs",
      "category": "security",
      "severity": "warning",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/build/shopify-app-configuration",
      "officialSourceTitle": "Shopify App Configuration",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#direct-mutations",
      "notes": "All data changes must go through Shopify APIs",
      "evidenceExpectations": ["No direct DB writes detected", "All mutations via Admin API"]
    },
    {
      "id": "privacy-support-urls",
      "title": "Privacy Policy and Support URLs",
      "description": "App must provide privacy policy and support URLs",
      "category": "privacy",
      "severity": "blocker",
      "validationMode": "automatic",
      "applicability": ["embedded_public_app", "online_store_extension"],
      "officialSourceUrl": "https://shopify.dev/docs/apps/launch/app-requirements-checklist",
      "officialSourceTitle": "App Requirements Checklist",
      "verifiedAt": "2026-08-02T00:00:00Z",
      "sourceVersion": "2026-08",
      "thirdPartyReference": "creativehubspace/shopify-app-store-requirements#privacy-support",
      "notes": "Both URLs required for public apps",
      "evidenceExpectations": ["Valid privacy policy URL", "Valid support URL"]
    },
    {
      "id": "name-description",
