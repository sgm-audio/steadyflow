{
  "name": "@steadyflow/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:zip": "pnpm build && cd dist && zip -r ../steadyflow-ext-v0.2.0.zip .",
    "dev": "vite",
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@steadyflow/core": "workspace:*",
    "@steadyflow/sdk": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.270",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
