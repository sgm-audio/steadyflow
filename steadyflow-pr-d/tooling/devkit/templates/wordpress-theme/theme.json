{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#121212" },
        { "slug": "paper", "name": "Paper", "color": "#f7f4ef" },
        { "slug": "accent", "name": "Accent", "color": "#1f6f5b" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
          "name": "Display",
          "slug": "display"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--display)"
    }
  }
}
