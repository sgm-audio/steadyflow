{
  "name": "@steadyflow/devkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scaffold Shopify themes/apps and WordPress plugins/themes for Steadyflow commerce work.",
  "bin": {
    "steadyflow-dev": "./bin/steadyflow-dev.mjs"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "scaffold": "node ./bin/steadyflow-dev.mjs scaffold",
    "test": "node --test ./src/scaffold.test.js",
    "typecheck": "node -e \"console.log('devkit: plain JS, no typecheck')\"",
    "build": "node -e \"console.log('devkit: plain JS, no build')\"",
    "lint": "node -e \"console.log('devkit: skip')\"",
    "clean": "node -e \"process.exit(0)\""
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
