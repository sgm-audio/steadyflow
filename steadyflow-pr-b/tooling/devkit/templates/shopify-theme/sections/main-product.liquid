{% comment %}
  {{ NAME }} — product section
  Wire margin / Printify cost flags from Steadyflow insights in app blocks later.
{% endcomment %}
<section class="sf-product">
  <h1>{{ product.title }}</h1>
  <div class="sf-product__price">{{ product.price | money }}</div>
  {{ product.description }}
  {% form 'product', product %}
    <button type="submit" name="add">Add to cart</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [],
  "presets": [{ "name": "Main product" }]
}
{% endschema %}
